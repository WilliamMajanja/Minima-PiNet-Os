# InfluxDB secret template — DO NOT commit with real values.
# Create the secret manually before applying k8s/influxdb.yaml:
#
#   kubectl create namespace zedd-weather
#   kubectl create secret generic influxdb-secret \
#     --namespace zedd-weather \
#     --from-literal=admin-token=<strong-32-char-token> \
#     --from-literal=admin-password=<strong-password>
#
# Alternatively use Sealed Secrets or External Secrets Operator to manage
# this secret declaratively without storing sensitive data in Git.
#
# If you prefer applying a YAML manifest, copy this file to
# influxdb-secret.yaml, fill in real values, apply it BEFORE influxdb.yaml,
# and NEVER commit the filled-in copy to version control.
#
# ---
# apiVersion: v1
# kind: Secret
# metadata:
#   name: influxdb-secret
#   namespace: zedd-weather
# type: Opaque
# stringData:
#   admin-token: "<replace-with-strong-token>"
#   admin-password: "<replace-with-strong-password>"
