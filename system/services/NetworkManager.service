[Unit]
Description=PiNetOS Network Manager
Documentation=https://github.com/WilliamMajanja/Minima-PiNet-Os
After=dbus.service
Before=network.target
Wants=dbus.service

[Service]
Type=dbus
BusName=org.freedesktop.NetworkManager
ExecStart=/usr/sbin/NetworkManager --no-daemon
Restart=on-failure

[Install]
WantedBy=multi-user.target
Also=NetworkManager-wait-online.service
