[Unit]
Description=Minima Blockchain Node
After=network-online.target cpip.service
Wants=network-online.target
Documentation=https://github.com/WilliamMajanja/Minima-PiNet-Os

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/minima
Environment=PINET_MINIMA_P2P_PORT=9001
Environment=PINET_MINIMA_RPC_PORT=9005
Environment=CPIP_ENABLED=1
Environment=CPIP_DEFENSE_ENABLED=1
Environment=CPIP_RPC_AUTH=1
Environment=CPIP_FIPS=0
Environment=CPIP_RECIPE=minima
Environment=CPIP_TOKEN_TTL=300
ExecStart=/usr/bin/java -Xmx512m -jar /opt/minima/minima.jar -daemon -rpcenable -port 9001 -mdsenable
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minima-node
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target