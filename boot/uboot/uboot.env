# =============================================================================
# U-Boot Configuration for PiNetOS on Raspberry Pi 5 (BCM2712)
# Place as uboot.env on the FAT boot partition to override defaults.
# =============================================================================

# Board identity
board=rpi_5
soc=bcm2712
arch=arm64

# ---- Memory layout ----------------------------------------------------------
kernel_addr_r=0x80000
fdt_addr_r=0x02800000
ramdisk_addr_r=0x03000000
scriptaddr=0x02400000
pxefile_addr_r=0x02100000
fdtoverlay_addr_r=0x02700000

# ---- Boot files -------------------------------------------------------------
kernel_name=kernel8.img
fdtfile=bcm2712-rpi5-b.dtb
boot_part=1
rootdev=/dev/mmcblk0p2

# ---- Kernel arguments -------------------------------------------------------
bootargs_base=console=ttyAMA0,115200 console=tty1
bootargs_fs=rootfstype=ext4 fsck.repair=yes rootwait
bootargs_cg=cgroup_enable=memory cgroup_memory=1 swapaccount=1 systemd.unified_cgroup_hierarchy=1
bootargs_splash=quiet splash plymouth.ignore-serial-consoles
bootargs=${bootargs_base} root=${rootdev} ${bootargs_fs} ${bootargs_cg} ${bootargs_splash}

# ---- Boot sequence ----------------------------------------------------------
# 1. Try loading from SD card
# 2. Try loading from USB
# 3. Try netboot (PXE)
boot_targets=mmc0 usb0 pxe

# ---- SD card boot -----------------------------------------------------------
mmc_boot=\
    echo "PiNetOS: Booting from SD card...";\
    mmc dev 0;\
    load mmc 0:${boot_part} ${kernel_addr_r} ${kernel_name};\
    load mmc 0:${boot_part} ${fdt_addr_r} ${fdtfile};\
    booti ${kernel_addr_r} - ${fdt_addr_r}

# ---- USB / NVMe boot --------------------------------------------------------
usb_boot=\
    echo "PiNetOS: Booting from USB/NVMe...";\
    usb start;\
    load usb 0:${boot_part} ${kernel_addr_r} ${kernel_name};\
    load usb 0:${boot_part} ${fdt_addr_r} ${fdtfile};\
    booti ${kernel_addr_r} - ${fdt_addr_r}

# ---- PXE / Network boot (TFTP) ----------------------------------------------
pxe_boot=\
    echo "PiNetOS: Trying PXE network boot...";\
    dhcp;\
    pxe get;\
    pxe boot

# ---- Auto-boot with 3-second countdown --------------------------------------
bootdelay=3
bootcmd=\
    echo "PiNetOS U-Boot ${ver}";\
    echo "Board: ${board}, Arch: ${arch}";\
    run mmc_boot || run usb_boot || run pxe_boot || echo "All boot methods failed!"
