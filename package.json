{
  "name": "pinet-web3-os",
  "version": "1.2.0",
  "description": "A modern, zero-bloat OS made for Raspberry Pi \u2014 Web3-native, AI-accelerated, and enterprise-grade secure.",
  "keywords": [
    "raspberry-pi",
    "pinet",
    "minima",
    "web3",
    "edge-ai",
    "arm64",
    "linux",
    "lxc",
    "blockchain"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python run.py",
    "dev": "python run.py",
    "release:validate-boot": "node scripts/validate-boot-config.js",
    "release:smoke-cli": "bash scripts/smoke-test-cli.sh",
    "release:img": "bash scripts/create-release-img.sh",
    "release:packages": "node scripts/generate-release-packages.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "overrides": {
    "lodash": ">=4.18.1",
    "axios": ">=1.15.0",
    "protobufjs": ">=7.5.5",
    "follow-redirects": ">=1.15.12"
  }
}
