# PiNet-OS v2.0.0 — RISC-V Kernel Configuration
# Target: StarFive JH7110 (VisionFive 2) / Allwinner D1 (MangoPi MQ-Pro)
#
# Minimal RISC-V kernel config for PiNet-OS edge nodes.
# Based on defconfig for riscv64 with PiNet-OS-specific options enabled.
#
# Build:
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- defconfig
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- -j$(nproc)
#   make ARCH=riscv CROSS_COMPILE=riscv64-linux-gnu- modules_install

# ─── Architecture ──────────────────────────────────────────────
CONFIG_RISCV=y
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_SVPBMT=y
CONFIG_RISCV_ISA_ZICBOM=y
CONFIG_FPU=y

# ─── Platform Support ─────────────────────────────────────────
CONFIG_ARCH_STARFIVE=y
CONFIG_SOC_STARFIVE=y
CONFIG_SOC_SIFIVE=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_ALLWINNER=y

# ─── SMP ──────────────────────────────────────────────────────
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# ─── Boot & Firmware ──────────────────────────────────────────
CONFIG_EFI=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y

# ─── Device Drivers ───────────────────────────────────────────
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_DW_APB=y
CONFIG_SERIAL_DW_APB_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_DWCMSDC=y
CONFIG_MMC_STARFIVE=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y

# GPIO
CONFIG_GPIO_DWAPB=y
CONFIG_GPIOLIB=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE=y
CONFIG_I2C_CHARDEV=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_DESIGNWARE=y
CONFIG_SPI_SPIDEV=y

# 1-Wire (for DS18B20 custom sensors)
CONFIG_W1=y
CONFIG_W1_MASTER_GPIO=y
CONFIG_W1_SLAVE_THERM=y

# ─── Filesystems ──────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y

# ─── Networking ──────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_WIREGUARD=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# ─── Crypto (CPIP-compatible) ────────────────────────────────
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_RSA=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_DEV_VIRTIO=y

# ─── TPM 2.0 (Hardware Key-Wrap) ─────────────────────────────
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_TIS_SPI=y
CONFIG_HW_RANDOM_TPM=y

# ─── LXC / Container Support ─────────────────────────────────
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_CGROUP_CPU=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_MEMORY=y
CONFIG_CGROUP_IO=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# ─── Power Management ─────────────────────────────────────────
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_IDLE=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# ─── Security ────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMUS=y
CONFIG_SECURITY_YAMA=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_LSM="yama,apparmor,integrity"

# ─── Module Support ──────────────────────────────────────────
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y

# ─── Debug (disabled for production) ─────────────────────────
# CONFIG_DEBUG_INFO is not set
# CONFIG_KASAN is not set