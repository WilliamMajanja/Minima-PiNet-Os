#!/bin/sh
# PiNet-OS Setup Script
# One-time setup: installs dependencies, downloads Minima, configures the environment
# POSIX-compatible — works on all Raspberry Pi models and compatible Linux systems

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source runtime library
. "$SCRIPT_DIR/../lib/pinet-runtime.sh"

printf "\n${WHITE}╔══════════════════════════════════════════════════╗${NC}\n"
printf "${WHITE}║       PiNet-OS v%s — Initial Setup           ║${NC}\n" "$PINET_VERSION"
printf "${WHITE}╚══════════════════════════════════════════════════╝${NC}\n\n"

# ─── Detect Platform ─────────────────────────────────────────────────────

detect_platform() {
  if [ -f /proc/device-tree/model ]; then
    _model=$(tr -d '\0' < /proc/device-tree/model)
  else
    _model="Unknown"
  fi

  case "$_model" in
    *"Raspberry Pi 5"*|*"BCM2712"*)
      printf "Raspberry Pi 5 (BCM2712 / ARM64)"
      ;;
    *"Raspberry Pi 4"*|*"BCM2711"*)
      printf "Raspberry Pi 4 (BCM2711 / ARM64)"
      ;;
    *"Raspberry Pi 3"*|*"BCM2837"*)
      printf "Raspberry Pi 3 (BCM2837 / ARM64)"
      ;;
    *"Raspberry Pi 2"*|*"BCM2836"*)
      printf "Raspberry Pi 2 (BCM2836 / ARM7)"
      ;;
    *"Raspberry Pi 1"*|*"BCM2835"*"Raspberry Pi Model"*)
      printf "Raspberry Pi 1 (BCM2835 / ARM6)"
      ;;
    *"Raspberry Pi Zero"*|*"BCM2835"*"Pi Zero"*)
      printf "Raspberry Pi Zero (BCM2835 / ARM6)"
      ;;
    *"Compute Module"*)
      printf "Raspberry Pi Compute Module"
      ;;
    *)
      printf "Generic Linux (%s)" "$_model"
      ;;
  esac
}

PLATFORM=$(detect_platform)
log_info "Platform: $PLATFORM"

# ─── Create Runtime Directories ───────────────────────────────────────────────

log_info "Creating runtime directories..."
init_runtime_dirs
log_ok "Runtime directories created at $PINET_HOME"

# ─── Check & Install Java ─────────────────────────────────────────────────────

log_info "Checking Java installation..."
if ! command -v java >/dev/null 2>&1; then
  log_warn "Java not found. Attempting to install OpenJDK 17..."
  if command -v apt >/dev/null 2>&1; then
    sudo apt update -qq && sudo apt install -y openjdk-17-jre-headless
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y java-17-openjdk-headless
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Sy --noconfirm jre17-openjdk-headless
  else
    log_error "Could not auto-install Java. Please install Java 17+ manually."
    exit 1
  fi
fi
check_java || exit 1

# ─── Check & Install Python ───────────────────────────────────────────────────

log_info "Checking Python installation..."
if ! command -v python3 >/dev/null 2>&1; then
  log_warn "Python3 not found. Attempting to install Python 3..."
  if command -v apt >/dev/null 2>&1; then
    sudo apt update -qq && sudo apt install -y python3 python3-pip python3-venv
  else
    log_error "Could not auto-install Python3. Please install Python 3.11+ manually."
    exit 1
  fi
fi
check_python || exit 1

# ─── Download Minima JAR ──────────────────────────────────────────────────────

MINIMA_JAR_URL="https://github.com/WilliamMajanja/Minima-private/releases/download/v1.0.49/minima-v1.0.49-cpip.jar"
MINIMA_JAR_FALLBACK_URL="https://github.com/WilliamMajanja/minima-core/releases/download/v1.0.49/minima-v1.0.49-cpip.jar"

if [ ! -f "$PINET_MINIMA_JAR" ]; then
  log_info "Downloading Minima v${PINET_MINIMA_VERSION}..."
  mkdir -p "$(dirname "$PINET_MINIMA_JAR")"
  _downloaded=0
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$PINET_MINIMA_JAR" "$MINIMA_JAR_URL" 2>/dev/null && _downloaded=1 || {
      log_warn "Primary download URL failed, trying fallback..."
      curl -fsSL -o "$PINET_MINIMA_JAR" "$MINIMA_JAR_FALLBACK_URL" 2>/dev/null && _downloaded=1 || true
    }
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$PINET_MINIMA_JAR" "$MINIMA_JAR_URL" 2>/dev/null && _downloaded=1 || {
      log_warn "Primary download URL failed, trying fallback..."
      wget -q -O "$PINET_MINIMA_JAR" "$MINIMA_JAR_FALLBACK_URL" 2>/dev/null && _downloaded=1 || true
    }
  fi

  if [ "$_downloaded" = "1" ] && [ -f "$PINET_MINIMA_JAR" ]; then
    log_ok "Minima JAR downloaded to $PINET_MINIMA_JAR"
  else
    log_warn "Could not download Minima JAR from GitHub."
    log_info "Please manually download v${PINET_MINIMA_VERSION} and place at: $PINET_MINIMA_JAR"
    log_info "Download URL: $MINIMA_JAR_URL"
  fi
else
  log_ok "Minima JAR already present at $PINET_MINIMA_JAR"
fi

# ─── Install Web Desktop Dependencies ─────────────────────────────────────────

log_info "Installing web desktop dependencies..."
cd "$PROJECT_DIR"
if [ -f "requirements.txt" ]; then
  python3 -m pip install --break-system-packages --upgrade pip >/dev/null 2>&1 || true
  python3 -m pip install --break-system-packages -r requirements.txt 2>/dev/null || {
    log_warn "pip install failed — web desktop may not work correctly."
  }
  log_ok "Python desktop dependencies installed."
else
  log_warn "requirements.txt not found in $PROJECT_DIR"
fi

# ─── Generate Initial Configuration ───────────────────────────────────────────

if [ ! -f "$PINET_CONFIG_FILE" ]; then
  log_info "Generating initial configuration..."
  generate_config "worker"
  log_ok "Configuration generated."
else
  log_ok "Configuration already exists at $PINET_CONFIG_FILE"
fi

# ─── Generate .env From Template ──────────────────────────────────────────────

cd "$PROJECT_DIR"
if [ ! -f ".env" ] && [ -f ".env.example" ]; then
  log_info "Creating .env from .env.example..."
  cp ".env.example" ".env"
  # Write the correct RPC port into .env
  if grep -q "PINET_MINIMA_RPC_PORT" .env 2>/dev/null; then
    sed -i "s/^PINET_MINIMA_RPC_PORT=.*/PINET_MINIMA_RPC_PORT=${PINET_MINIMA_RPC_PORT}/" .env
  else
    echo "PINET_MINIMA_RPC_PORT=${PINET_MINIMA_RPC_PORT}" >> .env
  fi
  log_ok ".env file created. Edit it to set your API keys and preferences."
elif [ -f ".env" ]; then
  log_ok ".env already exists."
fi

# ─── Generate Node Identity ───────────────────────────────────────────────────

IDENTITY_FILE="$PINET_STATE_DIR/identity.json"
if [ ! -f "$IDENTITY_FILE" ]; then
  _node_id=$(generate_node_id)
  cat > "$IDENTITY_FILE" << EOF
{
  "nodeId": "$_node_id",
  "platform": "$PLATFORM",
  "createdAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "hostname": "$(hostname 2>/dev/null || echo 'unknown')",
  "minimaRpcPort": $PINET_MINIMA_RPC_PORT,
  "minimaP2pPort": $PINET_MINIMA_P2P_PORT
}
EOF
  log_ok "Node identity created: $_node_id"
else
  log_ok "Node identity already exists."
fi

# ─── Summary ──────────────────────────────────────────────────────────────────

printf "\n${GREEN}╔══════════════════════════════════════════════════╗${NC}\n"
printf "${GREEN}║          Setup Complete!                          ║${NC}\n"
printf "${GREEN}╚══════════════════════════════════════════════════╝${NC}\n\n"

printf "  ${CYAN}Platform:${NC}   $PLATFORM\n"
printf "  ${CYAN}Runtime:${NC}    $PINET_HOME\n"
printf "  ${CYAN}Config:${NC}     $PINET_CONFIG_FILE\n"
printf "  ${CYAN}Minima:${NC}     $PINET_MINIMA_JAR\n"
printf "  ${CYAN}P2P Port:${NC}   $PINET_MINIMA_P2P_PORT\n"
printf "  ${CYAN}RPC Port:${NC}   $PINET_MINIMA_RPC_PORT\n"
printf "  ${CYAN}Node ID:${NC}    $(generate_node_id)\n"
printf "\n"
printf "  ${WHITE}Next steps:${NC}\n"
printf "    ${CYAN}pinet start${NC}                         # Start as worker node\n"
printf "    ${CYAN}pinet start --role master${NC}            # Start as master node\n"
printf "    ${CYAN}pinet start --role worker --master IP${NC} # Join a cluster\n"
printf "\n"