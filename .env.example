# ─────────────────────────────────────────────
# Minima-PiNet-OS — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── AI / Gemini ──────────────────────────────
# API key for Google Gemini (free tier)
GEMINI_API_KEY=

# API key for paid Gemini access (selected via key dialog)
API_KEY=

# ── GitHub Integration ────────────────────────
# Personal access token with repo:write scope (for release publishing)
GITHUB_TOKEN=
GITHUB_REPO=WilliamMajanja/Minima-PiNet-Os

# ── PiNetOS Server ────────────────────────────
# Port for the web desktop / API server (default: 3000)
PINET_DESKTOP_PORT=3000

# Allowed CORS origin for the API. In development the server serves the frontend
# directly, so the default is http://localhost:{PINET_DESKTOP_PORT}.
# In production set this to the exact origin of your frontend, or leave unset
# to disable the CORS header (same-origin only).
PINET_CORS_ORIGIN=

# ── File API ─────────────────────────────────
# Root directory accessible via /api/files/* endpoints (default: project cwd)
# Set this to a dedicated workspace directory to limit file-system exposure.
PINET_FILES_ROOT=

# ── Minima Blockchain Node ────────────────────
# Minima P2P port (default: 9001). This is the base port.
# The RPC port is automatically P2P_PORT + 4 (default: 9005).
# MDS file port = P2P + 2 (9003), MDS command port = P2P + 3 (9004).
PINET_MINIMA_P2P_PORT=9001
PINET_MINIMA_RPC_PORT=9005

# Full RPC URL override (if set, takes precedence over port-based URL)
# MINIMA_RPC_URL=http://127.0.0.1:9005

# ── Cluster Manager ───────────────────────────
# Port exposed by the PiNet Go cluster-manager daemon (default: 9090)
PINET_CLUSTER_API_PORT=9090

# ── Networking (optional overrides) ──────────
# Primary network interface to bind to
PINET_NETWORK_INTERFACE=eth0

# ── CPIP Security Provider (The Coffee Protocol) ──
# Enable CPIP as the security provider for all nodes (default: 1)
CPIP_ENABLED=1
# FIPS 140-2/3 mode: block startup on self-test failure (default: 0)
CPIP_FIPS=0
# CPIP sidecar URL for defense API calls
CPIP_PROVIDER_URL=http://127.0.0.1:4180
# API key for CPIP sidecar authentication
CPIP_API_KEY=
# Node identity certificate and key (PEM format)
CPIP_NODE_CERT=
CPIP_NODE_KEY=
# ITF Defense: probe blocking, pentest detection, IP blacklisting
CPIP_DEFENSE_ENABLED=1
# Covert key for CoffeeCipher encryption (auto-generated if empty)
CPIP_COVERT_KEY=
# Coffee recipe for key derivation domain separation
CPIP_RECIPE=minima
# RPC token time-to-live in seconds
CPIP_TOKEN_TTL=300
# Enable HMAC-SHA256 token auth for Minima RPC calls
CPIP_RPC_AUTH=1
# mTLS certificates for RPC transport security
CPIP_MTLS_CERT=
CPIP_MTLS_KEY=
CPIP_MTLS_CA=
# ITF Defense tuning
CPIP_DEFENSE_RATE_LIMIT=10
CPIP_DEFENSE_RATE_WINDOW=60
CPIP_DEFENSE_BLACKLIST_TTL=3600
CPIP_DEFENSE_MAX_BLACKLIST=1000