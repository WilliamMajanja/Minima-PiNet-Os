# ─────────────────────────────────────────────
# Minima-PiNet-OS — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── AI / Gemini ──────────────────────────────
# API key for Google Gemini (free tier)
GEMINI_API_KEY=

# API key for paid Gemini access (selected via key dialog)
API_KEY=

# ── GitHub Integration ────────────────────────
# Personal access token with repo:write scope (for release publishing)
GITHUB_TOKEN=
GITHUB_REPO=WilliamMajanja/Minima-PiNet-Os

# ── PiNetOS Server ────────────────────────────
# Port for the web desktop / API server (default: 3000)
PINET_DESKTOP_PORT=3000

# Allowed CORS origin for the API. In development the server serves the frontend
# directly, so the default is http://localhost:{PINET_DESKTOP_PORT}.
# In production set this to the exact origin of your frontend, or leave unset
# to disable the CORS header (same-origin only).
PINET_CORS_ORIGIN=

# ── File API ─────────────────────────────────
# Root directory accessible via /api/files/* endpoints (default: project cwd)
# Set this to a dedicated workspace directory to limit file-system exposure.
PINET_FILES_ROOT=

# ── Minima Blockchain Node ────────────────────
# Minima P2P port (default: 9001). This is the base port.
# The RPC port is automatically P2P_PORT + 4 (default: 9005).
# MDS file port = P2P + 2 (9003), MDS command port = P2P + 3 (9004).
PINET_MINIMA_P2P_PORT=9001
PINET_MINIMA_RPC_PORT=9005

# Full RPC URL override (if set, takes precedence over port-based URL)
# MINIMA_RPC_URL=http://127.0.0.1:9005

# RPC client tuning (milliseconds / retries)
PINET_MINIMA_RPC_TIMEOUT=10000
PINET_MINIMA_RPC_RETRIES=3
PINET_MINIMA_RPC_RETRY_DELAY=1.0

# ── Cluster Manager ───────────────────────────
# Port exposed by the PiNet Go cluster-manager daemon (default: 9090)
PINET_CLUSTER_API_PORT=9090

# ── Networking (optional overrides) ──────────
# Primary network interface to bind to
PINET_NETWORK_INTERFACE=eth0

# ── CPIP Security Provider (The Coffee Protocol) ──
# Enable CPIP as the security provider for all nodes (default: 1)
CPIP_ENABLED=1
# FIPS 140-2/3 mode: block startup on self-test failure (default: 0)
CPIP_FIPS=0
# CPIP sidecar URL for defense API calls
CPIP_PROVIDER_URL=http://127.0.0.1:4180
# API key for CPIP sidecar authentication
CPIP_API_KEY=
# Node identity certificate and key (PEM format)
CPIP_NODE_CERT=
CPIP_NODE_KEY=
# ITF Defense: probe blocking, pentest detection, IP blacklisting
CPIP_DEFENSE_ENABLED=1
# Covert key for CoffeeCipher encryption (auto-generated if empty)
CPIP_COVERT_KEY=
# Coffee recipe for key derivation domain separation
CPIP_RECIPE=minima
# RPC token time-to-live in seconds
CPIP_TOKEN_TTL=300
# Enable HMAC-SHA256 token auth for Minima RPC calls
CPIP_RPC_AUTH=1
# HTTP rate limiting (requests per window per IP)
CPIP_HTTP_RATE_LIMIT=500
CPIP_HTTP_RATE_WINDOW=120
# mTLS certificates for RPC transport security
CPIP_MTLS_CERT=
CPIP_MTLS_KEY=
CPIP_MTLS_CA=
# ITF Defense tuning
CPIP_DEFENSE_RATE_LIMIT=10
CPIP_DEFENSE_RATE_WINDOW=60
CPIP_DEFENSE_BLACKLIST_TTL=3600
CPIP_DEFENSE_MAX_BLACKLIST=1000

# ── v1.3.0: On-Device LLM Gateway ──────────────────────────────
# Enable the local LLM gateway (Ollama + Hailo-8L, fallback to Gemini)
PINET_LLM_GATEWAY=1
# Ollama API URL (default: http://127.0.0.1:11434)
PINET_LLM_GATEWAY_URL=http://127.0.0.1:11434
# Default model to use for chat completions
PINET_LLM_DEFAULT_MODEL=llama3.2:3b
# Maximum context window in tokens
PINET_LLM_MAX_CONTEXT=4096
# Directory for cached LLM models
PINET_LLM_MODELS_DIR=/opt/pinet/llm-models
# Fall back to Gemini cloud when local Ollama is unavailable
PINET_LLM_FALLBACK_GEMINI=1

# ── v1.3.0: Multi-Tenant LXC Quotas ────────────────────────────
# Enable per-tenant LXC resource quota management
PINET_LXC_QUOTA=1
# Default limits for new tenants
PINET_LXC_DEFAULT_CPU=50
PINET_LXC_DEFAULT_RAM_MB=512
PINET_LXC_DEFAULT_DISK_GB=10
PINET_LXC_DEFAULT_IO_IOPS=1000
# Maximum number of LXC tenants per node
PINET_LXC_MAX_TENANTS=16

# ── v1.3.0: Hardware Key-Wrap (TPM 2.0) ────────────────────────
# Enable TPM 2.0 hardware key-wrapping for CPIP master keys
PINET_TPM_KEYWRAP=1
# TPM device path
PINET_TPM_DEVICE=/dev/tpm0
# Path to the sealed key blob
PINET_TPM_SEALED_KEY=/opt/pinet/identity/cpip-sealed.key

# ── v1.3.0: CPIP PQ-TLS (Post-Quantum TLS) ─────────────────────
# Enable post-quantum TLS for CPIP RPC transport (hybrid ECDH+Kyber)
CPIP_PQ_TLS=0
# PQ KEM algorithm (kyber768)
CPIP_PQ_KEM=kyber768
# Use hybrid mode (classical + PQ, recommended)
CPIP_PQ_HYBRID=1

# ── v2.0.0: Formal Attestation ─────────────────────────────────
# Enable TPM 2.0 PCR-based remote attestation
PINET_ATTESTATION=1
# PCR bank to use for attestation
PINET_ATTESTATION_PCR_BANK=sha256
# Remote verification URL (optional, for external verifiers)
PINET_ATTESTATION_VERIFY_URL=

# ── v3.0.0: Confidential Computing Enclaves ────────────────────────────────
# Enable confidential computing enclaves (Arm CCA / RISC-V AP-TEE)
PINET_ENCLAVE=1
# Default memory per enclave in GB
PINET_ENCLAVE_DEFAULT_MEM_GB=1
# Maximum enclaves per node
PINET_ENCLAVE_MAX_PER_NODE=8
# TEE type to use (cca, riscv-tee, auto)
PINET_ENCLAVE_TEE_TYPE=auto

# ── v3.0.0: Verifiable Compute Proofs (zkVM) ──────────────────────────────
# Enable the zkVM prover (RISC Zero / SP1)
PINET_ZK_PROVER=1
# Prover timeout in seconds
PINET_ZK_PROVER_TIMEOUT=300
# Memory limit for prover in MB
PINET_ZK_PROVER_MEM_MB=1024

# ── v3.0.0: Decentralized Edge Compute Marketplace ────────────────────────
# Enable the decentralized compute marketplace
PINET_MARKETPLACE=1
# Maximum active listings per node
PINET_MARKETPLACE_MAX_LISTINGS=100
# Token used for escrow payments
PINET_MARKETPLACE_ESCROW_TOKENS=minima
# Minimum curation deposit in tokens
PINET_MARKETPLACE_CURATION_DEPOSIT=100

# ── SSL/TLS & HSTS (CPIP + mkcert) ──────────────────────────────────────────
# Enable SSL/TLS on the web server (default: 1)
PINET_SSL_ENABLED=1
# Directory for storing generated certificates
PINET_SSL_DIR=~/.local/share/pinet/ssl
# Explicit certificate and key paths (overrides auto-detection)
PINET_SSL_CERT=
PINET_SSL_KEY=
# Comma-separated list of hosts for the server certificate
PINET_SSL_HOSTS=localhost,127.0.0.1,::1
# Path to mkcert binary (default: mkcert, falls back to openssl)
PINET_MKCERT_PATH=mkcert

# HSTS (HTTP Strict Transport Security)
PINET_HSTS_ENABLED=1
# Max-age in seconds (default: 1 year = 31536000)
PINET_HSTS_MAX_AGE=31536000
# Include subdomains in HSTS policy
PINET_HSTS_INCLUDE_SUBDOMAINS=1
# Submit to HSTS preload list (requires includeSubDomains)
PINET_HSTS_PRELOAD=1